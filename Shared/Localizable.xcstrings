    "⚠️ Insufficient onchain balance\n\nRequired: %@\nAvailable: %@\nNeed to board: %@\n\nPlease board more Bitcoin to your savings balance before starting.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⚠️ Unzureichendes On-Chain-Guthaben\n\nErforderlich: %1$@\nVerfügbar: %2$@\nZu übertragen: %3$@\n\nBitte übertrage mehr Bitcoin auf dein Erspartes-Guthaben, bevor du beginnst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "⚠️ Insufficient onchain balance\n\nRequired: %1$@\nAvailable: %2$@\nNeed to board: %3$@\n\nPlease board more Bitcoin to your savings balance before starting."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⚠️ オンチェーン残高が不足しています\n\n必要額：%1$@\n利用可能：%2$@\n追加必要額：%3$@\n\n開始する前に、貯蓄残高にビットコインを追加してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "⚠️ 鏈上餘額不足\n\n所需金額：%1$@\n可用金額：%2$@\n需轉入：%3$@\n\n請先轉入更多比特幣至儲蓄餘額，再開始操作。"
          }
        }
      }
    }
