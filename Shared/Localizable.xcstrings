    "exit_blocked_fees_explanation": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Netzwerkgebühren sind derzeit höher als der Wert dieser Verschiebung. Sie wird automatisch abgeschlossen, wenn die Gebühren sinken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Network fees are currently higher than the value of this move. It will complete automatically when fees drop."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ネットワーク手数料が現在、この移動の価値より高くなっています。手数料が下がると自動的に完了します。"
          }
        }
      }
    },
    "exit_blocked_funds_explanation": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mehr Guthaben erforderlich, um Netzwerkgebühren zu decken. Füge Bitcoin zu deinem Erspartes hinzu, um fortzufahren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More funds needed to cover network fees. Add bitcoin to Savings to continue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ネットワーク手数料をカバーするために、より多くの資金が必要です。貯蓄に Bitcoin を追加して続行してください。"
          }
        }
      }
    },
    "exit_blocked_other_explanation": {
