    "Refresh is disabled because the amount (%@) is smaller than the minimum required (%@).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Erneuern ist deaktiviert, weil der Betrag (%1$@) kleiner ist als der erforderliche Mindestbetrag (%2$@)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Refresh is disabled because the amount (%1$@) is smaller than the minimum required (%2$@)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "金額（%1$@）が最小要件（%2$@）より小さいため、更新は無効です。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "由於金額（%1$@）低於最低要求（%2$@），更新已停用。"
          }
        }
      }
    },
