    "desc_maintenance_task": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dies ist eine regelmäßige Wartungsaufgabe, um dein Guthaben für schnelle und kostengünstige Zahlungen aktiv zu halten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a regular maintenance task to keep your balance active for fast and low-fee payments."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "これは残高を高速で低額の支払いに対応させるための定期的なメンテナンスタスクです。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "這是一項定期維護作業，可讓你的餘額保持活躍，以進行快速且低手續費的付款。"
          }
        }
      }
    },
    "desc_remove_wallet_device_only": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dies entfernt die Wallet nur von diesem Gerät. Du kannst sie später mit deiner Wiederherstellungsphrase wiederherstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will remove the wallet from this device only. You can restore it later with your recovery phrase."
