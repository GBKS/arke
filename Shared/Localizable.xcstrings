    "backup_file_section_description": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Füge optional deine Wallet-Backup-Datei hinzu, um deinen Transaktionsverlauf und deine Wallet-Daten wiederherzustellen. Ohne sie werden deine Mittel aus dem Netzwerk wiederhergestellt, aber der lokale Verlauf geht verloren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionally add your wallet backup file to restore your transaction history and wallet data. Without it, your funds are recovered from the network, but local history is not restored."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "オプションでウォレットバックアップファイルを追加して、取引履歴とウォレットデータを復元できます。これがなくても資金はネットワークから復元されますが、ローカル履歴は復元されません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "可選擇加入錢包備份檔案，以復原你的交易記錄和錢包資料。若沒有備份檔案，資金會從網路中復原，但本機記錄不會復原。"
          }
        }
      }
    },
