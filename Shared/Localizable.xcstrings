    "settings_offline_backup_help": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein Offline-Backup braucht beide Elemente unten. Deine Wiederherstellungsphrase allein stellt dein volles Guthaben nicht wieder her. Die Backup-Datei enthält Daten, die nur auf deinem Gerät und in iCloud existieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An offline backup needs both items below. Your recovery phrase alone won't recover your full balance. The backup file holds data that exists only on your device and in iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "オフラインバックアップには、以下の2つのアイテムが必要です。リカバリーフレーズだけでは、完全な残高を復元できません。バックアップファイルは、デバイスと iCloud にのみ存在するデータを保持します。"
          }
