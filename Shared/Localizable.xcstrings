    "settings_address_patterns": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Adressmuster"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Address Patterns"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "アドレスパターン"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "地址圖樣"
          }
        }
      }
    },
    "settings_address_patterns_experimental": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dies ist eine experimentelle Funktion. Muster sind am nützlichsten, wenn du sie über Apps vergleichen kannst — und vorerst ist Arké das erste Wallet, das sie anzeigt. Stell dir vor, wie die Adressüberprüfung sich anfühlen könnte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "This is an experimental feature. Patterns are most useful when you can compare them across apps — and for now, Arké is the first wallet to show them. Think of it as a preview of what address checking could feel like."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "これは実験的な機能です。パターンは複数のアプリで比較できる場合に最も役立ちます。今のところ、Arké はそれを表示する最初のウォレットです。アドレス確認がどのように感じられるかのプレビューと考えてください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "這是一項實驗性功能。圖樣要能在不同 App 之間比對才最有用——目前 Arké 是第一個顯示圖樣的錢包。可以把它當作地址核對未來體驗的預覽。"
          }
        }
      }
    },
    "settings_address_patterns_explainer": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jede Adresse bekommt ihr eigenes einzigartiges Muster, das aus der Adresse selbst generiert wird. Ein Blick reicht, um zu erkennen, ob zwei Adressen übereinstimmen, ohne sie Zeichen für Zeichen zu vergleichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Every address gets its own unique pattern, generated from the address itself. A glance is enough to tell whether two addresses match, without comparing them character by character."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "すべてのアドレスは、アドレス自体から生成される独自のパターンを取得します。2つのアドレスが一致しているかどうかを、1文字ずつ比較することなく判断することができます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "每個地址都有由地址本身產生的獨特圖樣。只要看一眼就能判斷兩個地址是否相符，不必逐字比對。"
          }
        }
      }
    },
    "settings_address_patterns_hint": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zeige einzigartige visuelle Muster, um Adressen zu identifizieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show unique visual patterns to help identify addresses"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "アドレスを識別するのに役立つ独自のビジュアルパターンを表示します"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "顯示獨特的視覺圖樣，協助辨識地址"
          }
        }
      }
    },
