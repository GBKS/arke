    "contacts_remove_address_warning": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dies entfernt die Adresse von %@s Kontaktkarte.\n\nTransaktionen, die vorher diesem Kontakt zugeordnet waren, bleiben zugeordnet. Du kannst sie einzeln in den Transaktionsdetails entfernen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will remove the address from %@'s contact card.\n\nTransactions previously assigned to this contact will remain assigned. You can unassign them individually from the transaction details."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "これにより%@さんの連絡先カードからアドレスが削除されます。\n\n以前このユーザーに割り当てられた取引は割り当てたままになります。取引詳細から個別に割り当てを解除できます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "這會將地址從「%@」的聯絡人卡片中移除。\n\n先前指派給這位聯絡人的交易將維持指派狀態。你可以在交易詳細資訊中逐筆取消指派。"
          }
        }
      }
    },
