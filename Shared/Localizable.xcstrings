    "desc_contacts_access_needed": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diese App benötigt die Berechtigung, um auf deine Kontakte zuzugreifen und Kontaktinformationen zu importieren."
          }
