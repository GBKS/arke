    "Refresh is disabled because the amount (%@) is smaller than the minimum required (%@)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Refresh is disabled because the amount (%1$@) is smaller than the minimum required (%2$@)."
