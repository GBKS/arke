    "balance_transfer_payments_help": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Transferiere Geldmittel zum Zahlungen-Guthaben für schnelle und geringe Gebühren-Zahlungen, gegen regelmäßige Wartungsgebühren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfer funds to the payments balance for fast and low-fee payments, in return for incurring regular maintenance fees."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "定期的なメンテナンス手数料と引き換えに、高速で低手数料の支払いのために支払い残高にファンドを転送してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "將資金轉移到支付餘額，享有快速、低手續費的支付，代價是需定期支付維護費。"
          }
        }
      }
    },
    "balance_transfer_payments_to_savings": {
