    "transaction_explainer_exit": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eine Rückgewinnung verschiebt Bitcoin von deinem Zahlungsguthaben zu deinem Erspartes, ohne die Beteiligung des Servers, der dies normalerweise ermöglicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A recovery moves bitcoin from your payments balance to your savings balance without the involvement of the server that typically facilitates this."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "回収は、ビットコインを支払い残高から貯蓄残高に移動させる操作であり、通常このプロセスを簡素化するサーバーの関与がありません。"
          }
        }
      }
    },
    "transaction_explainer_refresh": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eine Erneuerung ist eine Wartungsoperation, die die Lebensdauer deines Zahlungsguthabens verlängert. Es wurde kein Bitcoin gesendet oder empfangen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A refresh is a maintenance operation that extends the lifetime of your payments balance. No bitcoin was sent or received."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "更新は、支払い残高の有効期限を延長するメンテナンス操作です。ビットコインの送受信はありません。"
          }
        }
      }
    },
