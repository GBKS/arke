      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "This iCloud account already has a wallet. Rejoin it or import its recovery phrase — creating a second wallet would overwrite the existing one."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此 iCloud 帳號已有一個錢包。請重新加入該錢包，或匯入其復原片語；建立第二個錢包會覆寫現有的錢包。"
          }
        }
      }
    },
    "exit_blocked_fees_explanation": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Netzwerkgebühren sind derzeit höher als der Wert dieser Verschiebung. Sie wird automatisch abgeschlossen, wenn die Gebühren sinken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Network fees are currently higher than the value of this move. It will complete automatically when fees drop."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ネットワーク手数料が現在、この移動の価値より高くなっています。手数料が下がると自動的に完了します。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "網路手續費目前高於這筆轉移的價值。手續費下降後會自動完成。"
          }
        }
      }
    },
    "exit_blocked_funds_explanation": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mehr Guthaben erforderlich, um Netzwerkgebühren zu decken. Füge Bitcoin zu deinem Erspartes hinzu, um fortzufahren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More funds needed to cover network fees. Add bitcoin to Savings to continue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ネットワーク手数料をカバーするために、より多くの資金が必要です。貯蓄に Bitcoin を追加して続行してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "需要更多資金來支付網路手續費。將比特幣加入儲蓄以繼續。"
          }
        }
      }
    },
    "exit_blocked_other_explanation": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Es gibt ein temporäres Problem. Es wird automatisch erneut versucht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is a temporary problem. It will be retried automatically."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "一時的な問題が発生しています。自動的に再試行されます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "目前有暫時性問題，將會自動重試。"
          }
        }
      }
    },
    "exit_cancelled_explanation": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diese Verschiebung wurde abgebrochen, da die Guthaben bereits auf andere Weise verwaltet wurden. Es wurde nichts verloren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This move was cancelled because the funds were already moved another way. Nothing was lost."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この移動は既に別の方法で資金が移動されたためキャンセルされました。何も失われていません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "這筆轉移已取消，因為資金已透過其他方式轉移。沒有任何損失。"
          }
        }
      }
    },
