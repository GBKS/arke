    "settings_unlink_all_help": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nutze dies, wenn du ein Gerät verloren hast oder Zugriff von allen anderen Geräten widerrufen möchtest. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this if you've lost a device or want to revoke access from all other devices. This cannot be undone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "デバイスを紛失した場合、または他のすべてのデバイスからのアクセスを取り消す場合に使用します。このアクションは取り消せません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "如果你遺失裝置，或想撤銷所有其他裝置的存取權，請使用此功能。這項操作無法復原。"
          }
        }
      }
    },
    "settings_unlink_all_warning": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alle anderen Geräte verlieren Zugriff auf das Wallet. Sie müssen die Wiederherstellungsphrase neu importieren, um den Zugriff zurückzugewinnen. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All other devices will lose access to the wallet. They will need to re-import the recovery phrase to regain access. This action cannot be undone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "他のすべてのデバイスはウォレットへのアクセスを失います。アクセスを回復するには、リカバリーフレーズを再度インポートする必要があります。このアクションは取り消せません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "所有其他裝置將失去這個錢包的存取權，必須重新匯入復原片語才能再次存取。這項操作無法復原。"
          }
        }
      }
