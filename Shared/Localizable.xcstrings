    "settings_delete_backup_reminder": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hast du ein manuelles Backup abgeschlossen? Du brauchst sowohl deine Wiederherstellungsphrase als auch die Wallet-Zustandsdatei, um dein Wallet vollständig wiederherzustellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Have you completed a manual backup? You need both your recovery phrase and wallet state file to fully restore your wallet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "手動バックアップを完了しましたか。ウォレットを完全に復元するには、リカバリーフレーズと状態ファイルの両方が必要です。"
          }
        }
      }
    },
    "settings_delete_balance_warning": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du hast noch Mittel in deinem Wallet. Stelle sicher, dass du sie vor dem Löschen überweist, oder akzeptiere, dass kleine Beträge unter Mindestgebühren möglicherweise nicht wiederhergestellt werden können."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You still have funds in your wallet. Make sure to transfer them out before deleting, or accept that small amounts below minimum fees may not be recoverable."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ウォレットにはまだ資金があります。削除する前に転送するか、最小手数料以下の少量の金額は回収できないことを受け入れてください。"
          }
        }
      }
    },
    "settings_delete_permanent_warning_everywhere": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alle Wallet-Daten werden dauerhaft von diesem Gerät und iCloud gelöscht. Kein Zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "All wallet data will be permanently deleted from this device and iCloud. No turning back."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "すべてのウォレットデータは、このデバイスと iCloud から永続的に削除されます。戻ることはできません。"
          }
        }
      }
    },
    "settings_delete_permanent_warning_local_only": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alle Wallet-Daten werden dauerhaft von diesem Gerät gelöscht. Deine anderen Geräte behalten dieses Wallet — öffne eines davon, um es zum aktiven Gerät zu machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "All wallet data will be permanently deleted from this device. Your other devices keep this wallet — open one of them to make it the active device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "すべてのウォレットデータはこのデバイスから永続的に削除されます。他のデバイスはこのウォレットを保持します。そのうちの1つを開いてアクティブなデバイスにします。"
          }
        }
      }
    },
    "settings_delete_wallet_title": {
      "localizations": {
