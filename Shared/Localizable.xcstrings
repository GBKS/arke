        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wiederherstellungsphrase"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery Phrase"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "リカバリーフレーズ"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "復原片語"
          }
        }
      }
    },
    "settings_recovery_phrase_help": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deine Wiederherstellungsphrase stellt dein Wallet wieder her. Jeder, der sie hat, kann dein Bitcoin ausgeben. Halte sie sicher und teile sie niemals."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your recovery phrase restores your wallet. Anyone who has it can spend your bitcoin. Keep it safe and never share it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "リカバリーフレーズはウォレットを復元します。それを持っている人は誰でもビットコインを使用できます。安全に保ち、決して共有しないでください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "復原片語可用來復原你的錢包。任何持有它的人都能動用你的比特幣。請妥善保管，切勿與他人分享。"
          }
        }
      }
    },
