    "linked_devices_multiple_devices_description": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nur dein Hauptgerät kann ausgeben. Zweitgeräte können Guthaben und Verlauf anzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only your primary device can spend. Secondary devices can view balance and history."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "メインデバイスのみが送金できます。サブデバイスは残高と履歴を表示できます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "只有主要裝置可以動用資金。次要裝置可以查看餘額和記錄。"
          }
        }
      }
    },
    "linked_devices_no_active_wallet": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kein aktives Wallet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Active Wallet"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "アクティブなウォレットがありません"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "沒有使用中的錢包"
          }
        }
      }
    },
    "linked_devices_no_active_wallet_description": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mache dieses Gerät zu deinem Hauptgerät, um zu senden und zu empfangen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make this device your primary wallet to send and receive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このデバイスをメインデバイスにして、送金と受け取りを行えるようにします。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "將此裝置設為主要錢包，即可傳送和接收款項。"
          }
        }
      }
    },
    "linked_devices_single_device_description": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du nutzt Arké auf einem Gerät. Installiere Arké auf einem anderen iPhone oder iPad, das sich im selben iCloud-Konto anmeldet, und es wird hier automatisch angezeigt. Zunächst nur-Lesen, bereit zu übernehmen, wenn du es brauchst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're using Arké on one device. Install Arké on another iPhone or iPad signed in to the same iCloud, and it'll appear here automatically. View-only at first, ready to take over if you need it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Arké を1つのデバイスで使用しています。同じ iCloud アカウントにサインインしている別の iPhone または iPad に Arké をインストールすると、ここに自動的に表示されます。最初は閲覧専用で、必要に応じて引き継ぐ準備ができています。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你目前只在一部裝置上使用 Arké。在另一部登入同一 iCloud 帳號的 iPhone 或 iPad 上安裝 Arké，它就會自動顯示在這裡。一開始為唯讀模式，需要時隨時可以接手。"
          }
        }
      }
    },
